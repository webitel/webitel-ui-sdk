
# all packages
/packages/**/node_modules

# ui-datalist pckg
/packages/ui-datalist/types

# ui-chats pckg
/packages/ui-chats/types

# api-services pckg
/packages/api-services/types
/packages/api-services/src/gen/_docs

# styleguide pckg
/packages/styleguide/types

/types

# Declaration emit belongs in types/ (see declarationDir). Never commit beside sources.
# Keep ambient module shims at package src roots (e.g. src/declaration.d.ts).
# Exception: components barrel — JS entry cannot emit declarations reliably; hand-maintained.
src/**/*.d.ts
!src/*.d.ts
!src/components/index.d.ts
packages/*/src/**/*.d.ts
!packages/*/src/*.d.ts

# Project references build cache
**/.tsbuildinfo
**/*.d.ts.map

# misc
.DS_Store
node_modules
/dist
/docs/.vitepress/cache
/docs/.vitepress/dist
/coverage

# local env files
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor
CLAUDE.md
.claude

vite.config.*.timestamp*
.eslintcache
