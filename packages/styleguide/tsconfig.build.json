{
	"extends": "../../tsconfig.json",
	"include": [
		"src"
	],
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"declarationDir": "types",
		"tsBuildInfoFile": "types/.tsbuildinfo",
		"rootDir": "./src",
		"noEmit": false
	}
}
