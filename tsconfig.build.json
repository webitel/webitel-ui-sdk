{
	"extends": "./tsconfig.base.json",
	"include": [
		"src"
	],
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationDir": "./types",
		"tsBuildInfoFile": "./types/.tsbuildinfo",
		"noEmit": false,
		"allowJs": true,
		"rootDir": "./src",
		"disableSourceOfProjectReferenceRedirect": true,
		"paths": {
			"zod": [
				"./node_modules/zod"
			],
			"zod/v4": [
				"./node_modules/zod/v4"
			],
			"vue": [
				"./node_modules/vue"
			],
			"@vueuse/core": [
				"./node_modules/@vueuse/core"
			],
			"@vueuse/shared": [
				"./node_modules/@vueuse/shared"
			],
			"@webitel/ui-sdk/src/*": [
				"./src/*"
			],
			"@webitel/ui-sdk/validators/*": [
				"./src/validations/vuelidate/validators/*"
			],
			"@webitel/ui-sdk/*": [
				"./src/*"
			]
		}
	},
	"references": [
		{
			"path": "./packages/api-services/tsconfig.build.json"
		},
		{
			"path": "./packages/styleguide/tsconfig.build.json"
		}
	]
}
