{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"paths": {
			"@aliasedDeps/api-services/axios": [
				"./node_modules/axios",
				"./packages/api-services/node_modules/axios"
			],
			"zod": [
				"./node_modules/zod"
			],
			"zod/v4": [
				"./node_modules/zod/v4"
			],
			"vue": [
				"./node_modules/vue"
			],
			"@vueuse/core": [
				"./node_modules/@vueuse/core"
			],
			"@vueuse/shared": [
				"./node_modules/@vueuse/shared"
			],
			"@webitel/api-services": [
				"./packages/api-services/types/index"
			],
			"@webitel/api-services/gen": [
				"./packages/api-services/types/gen/index"
			],
			"@webitel/api-services/gen/models": [
				"./packages/api-services/types/gen/_models/index"
			],
			"@webitel/api-services/gen/utils": [
				"./packages/api-services/types/utils/gen/index"
			],
			"@webitel/api-services/api": [
				"./packages/api-services/types/api/clients/index"
			],
			"@webitel/api-services/api/*": [
				"./packages/api-services/types/api/*"
			],
			"@webitel/api-services/enums": [
				"./packages/api-services/types/enums/index"
			],
			"@webitel/api-services/utils": [
				"./packages/api-services/types/utils/index"
			],
			"@webitel/api-services/scripts": [
				"./packages/api-services/types/scripts/index"
			],
			"@webitel/api-services/validations": [
				"./packages/api-services/types/validations/index"
			],
			"@webitel/api-services/locale": [
				"./packages/api-services/types/locale/locale"
			],
			"@webitel/ui-sdk/src/*": [
				"./src/*"
			],
			"@webitel/ui-sdk/validators/*": [
				"./src/validations/vuelidate/validators/*"
			],
			"@webitel/ui-sdk/*": [
				"./src/*"
			]
		}
	}
}
